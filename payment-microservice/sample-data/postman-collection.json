{
	"info": {
		"_postman_id": "payment-microservice-collection",
		"name": "Payment Microservice API",
		"description": "Sample requests for the Payment Microservice. In deterministic demo mode every charge succeeds, except a card charge >= 1,500,000 LKR which is held for step-up authorization on the first attempt and clears on retry.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8081" }
	],
	"item": [
		{
			"name": "Payment Scenarios",
			"item": [
				{
					"name": "Payment - Success (normal value)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"orderId\": \"ORDER-NEO-001\",\n    \"amount\": 350625.00,\n    \"currency\": \"LKR\",\n    \"paymentMethod\": \"CARD\",\n    \"customerId\": \"CUST-001\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
						"description": "Below the step-up threshold, so it succeeds immediately (status SUCCESS)."
					}
				},
				{
					"name": "Payment - High-value step-up hold (>= 1.5M)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"orderId\": \"ORDER-BULK-001\",\n    \"amount\": 1800675.00,\n    \"currency\": \"LKR\",\n    \"paymentMethod\": \"CARD\",\n    \"customerId\": \"CUST-CORP-01\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
						"description": "First attempt returns status FAILED with failureReason 'Bank authorization hold ...'. Copy the paymentReference and call Retry Payment - it clears to SUCCESS."
					}
				}
			]
		},
		{
			"name": "Make Payment",
			"item": [
				{
					"name": "Make Payment - CARD",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"orderId\": \"ORDER-001\",\n    \"amount\": 350625.00,\n    \"currency\": \"LKR\",\n    \"paymentMethod\": \"CARD\",\n    \"customerId\": \"CUST-001\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
					}
				},
				{
					"name": "Make Payment - CASH",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"orderId\": \"ORDER-002\",\n    \"amount\": 25000.00,\n    \"currency\": \"LKR\",\n    \"paymentMethod\": \"CASH\",\n    \"customerId\": \"CUST-002\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
					}
				},
				{
					"name": "Make Payment - BANK_TRANSFER",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"orderId\": \"ORDER-003\",\n    \"amount\": 100000.00,\n    \"currency\": \"LKR\",\n    \"paymentMethod\": \"BANK_TRANSFER\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
						"description": "customerId is optional."
					}
				},
				{
					"name": "Make Payment - USD Currency",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"orderId\": \"ORDER-004\",\n    \"amount\": 500.00,\n    \"currency\": \"USD\",\n    \"paymentMethod\": \"CARD\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
					}
				},
				{
					"name": "Make Payment - Validation Error (400)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"amount\": 1500.00,\n    \"currency\": \"LKR\",\n    \"paymentMethod\": \"CARD\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
						"description": "Missing required orderId. Returns 400 Validation Failed."
					}
				}
			]
		},
		{
			"name": "Retry Payment",
			"item": [
				{
					"name": "Retry Payment - Change Method",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"paymentMethod\": \"BANK_TRANSFER\",\n    \"reason\": \"Card declined, trying bank transfer\"\n}" },
						"url": { "raw": "{{baseUrl}}/payments/PAY-XXXXXXXX/retry", "host": ["{{baseUrl}}"], "path": ["payments", "PAY-XXXXXXXX", "retry"] },
						"description": "Replace PAY-XXXXXXXX with a real paymentReference (e.g. from the high-value hold)."
					}
				},
				{
					"name": "Retry Payment - Empty Body",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}" },
						"url": { "raw": "{{baseUrl}}/payments/PAY-XXXXXXXX/retry", "host": ["{{baseUrl}}"], "path": ["payments", "PAY-XXXXXXXX", "retry"] }
					}
				},
				{
					"name": "Retry Payment - Non-existent (404)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{}" },
						"url": { "raw": "{{baseUrl}}/payments/PAY-INVALID123/retry", "host": ["{{baseUrl}}"], "path": ["payments", "PAY-INVALID123", "retry"] }
					}
				}
			]
		},
		{
			"name": "Get Payment",
			"item": [
				{
					"name": "Get Payment by Reference",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{baseUrl}}/payments/PAY-XXXXXXXX", "host": ["{{baseUrl}}"], "path": ["payments", "PAY-XXXXXXXX"] },
						"description": "Replace PAY-XXXXXXXX with a real paymentReference."
					}
				},
				{
					"name": "Get Payment - Non-existent (404)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{baseUrl}}/payments/PAY-INVALID123", "host": ["{{baseUrl}}"], "path": ["payments", "PAY-INVALID123"] }
					}
				}
			]
		},
		{
			"name": "Actuator",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
					}
				}
			]
		}
	]
}
